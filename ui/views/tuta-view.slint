// The Tuta tab.
//
// Tuta's account exists only as the official web app, which Yours keeps
// running in a background process (src/tuta_window.rs) so its notifications
// keep being read aloud. This tab shows that page.
//
// When Yours runs as an X11 client (the normal case on a Wayland session with
// XWayland) the app reparents the web app's window into its own and holds it
// over this view's content rectangle (src/tuta_embed.rs). The page is then
// genuinely inside the tab: clicks, typing, selection and scrolling are the
// page's own. Nothing is drawn over that rectangle, so nothing sits between
// the pointer and the page.
//
// On a Wayland-only session a client cannot reparent another client's surface,
// so the tab falls back to frames from WebKitGTK's snapshot API: a live
// picture, with an explicit note saying so and the button that opens the
// interactive window for clicking and typing.
import { AppTheme, LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "../components/button.slint";
import { TutaWebApp } from "../tuta-web-app.slint";

export component TutaWebAppView inherits Rectangle {
    // Leave the tab and go back to mail.
    callback back();
    // Show the interactive web app window.
    callback show-window();

    background: AppTheme.page-bg;

    // The page, when the session can put it inside the tab.
    if TutaWebApp.embedding : Rectangle {
        // The web app's window is an X11 window the app places over this
        // rectangle. Publishing the rectangle is what keeps the two in step:
        // the timer follows every layout change, resize and tab switch.
        page := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #141516;
            clip: true;
        }

        Timer {
            interval: 100ms;
            running: true;
            triggered => {
                TutaWebApp.embed-x = page.absolute-position.x;
                TutaWebApp.embed-y = page.absolute-position.y;
                TutaWebApp.embed-width = page.width;
                TutaWebApp.embed-height = page.height;
            }
        }

        // Only until the page's window is in place: the embedded window
        // covers this, so it is the honest state of the tab, not a control.
        if !TutaWebApp.embedded : VerticalLayout {
            alignment: center;
            spacing: 6px;

            Text {
                text: @tr("Attaching the Tuta web app…");
                color: AppTheme.title;
                font-size: TypeScale.body;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("The page is interactive as soon as its window is placed in this tab.");
                color: AppTheme.muted;
                font-size: TypeScale.caption;
                horizontal-alignment: center;
            }
        }
    }

    // The snapshot fallback: a Wayland-only session, where the page cannot be
    // reparented into the window and the tab can only be a picture of it.
    if !TutaWebApp.embedding : VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // A tab-shaped header, on the same row height as the workspace titles.
        Rectangle {
            height: LayoutMetrics.touch-target + 10px;
            background: AppTheme.surface;

            HorizontalLayout {
                padding-left: LayoutMetrics.compact-inset;
                padding-right: LayoutMetrics.compact-inset;
                spacing: 10px;

                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/lucide/outline/external-link.svg");
                    image-fit: contain;
                }

                Text {
                    text: @tr("Tuta web app");
                    color: AppTheme.title;
                    font-size: TypeScale.title-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("Background · notifications read aloud");
                    color: AppTheme.muted;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Button {
                    text: @tr("Open interactive window");
                    horizontal-stretch: 0;
                    clicked => { root.show-window(); }
                }

                Button {
                    text: @tr("Back to mail");
                    horizontal-stretch: 0;
                    clicked => { root.back(); }
                }
            }
        }

        // Why the tab is a picture: this is the Wayland fallback and the note
        // has to say so, because the page cannot be clicked here.
        Rectangle {
            height: 30px;
            background: AppTheme.accent-pale;

            HorizontalLayout {
                padding-left: LayoutMetrics.compact-inset;
                padding-right: LayoutMetrics.compact-inset;

                Text {
                    text: @tr("Wayland session without XWayland: the tab is a live picture, not the page. Clicks and typing need “Open interactive window”.");
                    color: AppTheme.secondary;
                    font-size: TypeScale.caption;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // The web view's picture. Letterboxed on a dark bed, like the window's
        // own page, until the first frame arrives.
        Rectangle {
            vertical-stretch: 1;
            background: #141516;
            clip: true;

            if TutaWebApp.has-frame : Image {
                source: TutaWebApp.frame;
                image-fit: contain;
                width: parent.width;
                height: parent.height;
            }

            if !TutaWebApp.has-frame : VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: @tr("Starting the Tuta web app…");
                    color: AppTheme.title;
                    font-size: TypeScale.body;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("It stays running in the background so its notifications are read aloud. Open the interactive window to click or type.");
                    color: AppTheme.muted;
                    font-size: TypeScale.caption;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 26px;
                height: 26px;
                width: parent.width;
                background: #00000099;

                Text {
                    x: LayoutMetrics.compact-inset;
                    width: parent.width - 2 * LayoutMetrics.compact-inset;
                    text: @tr("Tuta is running in the background. Closing its window does not stop it.");
                    color: white;
                    font-size: TypeScale.micro;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
