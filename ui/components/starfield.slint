// The Space preset's background is the owner's Firefox reference itself, not
// an imitation and not a procedural field. The installed theme contains only
// manifest.json plus img/background.gif (640x360, 119 frames, 60-70 ms); Rust
// embeds those exact pixels and this component tiles them at native size.
//
// One image pixel is one device pixel: a tile is 640/device-pixel-ratio
// logical pixels wide, the grid sits at exact multiples, and there are NO
// mirrors, flips, rotations or per-tile crops. The tile pattern repeats, but
// every star is the reference's own star.
//
// The whole field reads ONE clock. Two tile layers cross-fade the current
// reference frame into the next one. Reading animation-tick() registers the
// field as a running Slint animation, so the backend asks for another frame at
// every vsync instead of waking a plain timer. The frame index and the blend
// come from that same clock, so no tile can drift out of phase.

export struct SpaceTile {
    x: length,
    y: length,
}

export component Starfield inherits Rectangle {
    // The literal reference frames, supplied by AppWindow.space-frames.
    in property <[image]> frames;
    in property <int> frame-count: 119;
    // Whether the field may move: the theme is Space, motion is not reduced,
    // and the window is visible. When false the animation clock is not read.
    in property <bool> active: true;
    // The window's device pixel ratio, supplied by Rust after the window maps.
    in property <float> pixel-ratio: 1.0;
    // The tiles covering the window, rebuilt by Rust on resize.
    in property <[SpaceTile]> tiles;
    callback arrange(length, length);

    clip: true;
    accessible-role: none;

    // Rust knows the device pixel ratio, so it owns the tile layout. Width and
    // height change together on a resize; either one rebuilds the grid.
    changed width => { root.arrange(root.width, root.height); }
    changed height => { root.arrange(root.width, root.height); }

    // One clock for the whole field. 70ms is the reference GIF's frame step;
    // the blend is the same clock's position inside the step.
    private property <duration> clock: root.active ? animation-tick() : 0ms;
    private property <int> frame:
        floor(mod(root.clock, 70ms * root.frame-count) / 70ms);
    private property <float> blend: mod(root.clock, 70ms) / 70ms;

    for tile in root.tiles : Image {
        x: tile.x;
        y: tile.y;
        width: 640px / root.pixel-ratio;
        height: 360px / root.pixel-ratio;
        source: root.frames[root.frame];
        image-fit: fill;
        image-rendering: pixelated;
    }

    // The next reference frame fades in over the current one. Every tile uses
    // the same blend value, so the whole field changes together.
    for tile in root.tiles : Image {
        x: tile.x;
        y: tile.y;
        width: 640px / root.pixel-ratio;
        height: 360px / root.pixel-ratio;
        source: root.frames[Math.mod(root.frame + 1, root.frame-count)];
        image-fit: fill;
        image-rendering: pixelated;
        opacity: root.blend;
    }
}
