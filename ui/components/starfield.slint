// The Space preset's background is the owner's Firefox reference itself, not
// an imitation. The installed theme ships a 119-frame GIF (60-70 ms a frame)
// of a field that twinkles quickly; Rust embeds 24 lossless frames sampled
// evenly across that loop and the window's 70 ms timer asks for the next one.
// This component only paints the frame it is handed: no procedural stars, no
// drift, no parallax.
export component Starfield inherits Rectangle {
    // The current reference frame, supplied by AppWindow.space-frame.
    in property <image> frame-image;

    clip: true;
    accessible-role: none;

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.frame-image;
        // The reference is 640x360 (16:9); fill scales it to the window.
        image-fit: fill;
    }
}
