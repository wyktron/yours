import { AccountRow, ComposeAttachment, ComposeLink, ComposeContact, ComposeEditorTile, EmailTemplateRow, LocalizedMessage, SpellingLanguage } from "../models.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "button.slint";
import { EmailComposer } from "email-composer.slint";

// One message being written: its fields, the editor surface and the actions
// it asks the application for. Every window has its own copy of a global, so
// the main window's copy drives the composer it shows and each composer
// window drives the message moved into it.
export global ComposerUi {
    in-out property <bool> open: false;
    in property <string> mode: "new";
    in-out property <string> to: "";
    in-out property <string> cc: "";
    in-out property <string> bcc: "";
    in-out property <string> subject: "";
    in-out property <string> body: "";
    in property <bool> sending: false;
    // Files dragged from elsewhere are over the message.
    in property <bool> drop-hint: false;
    // Who asked to send this draft, when an AI agent did (#237), as the note
    // the composer shows over it. Empty otherwise.
    in property <string> review-note: "";
    // A signature being written ("signature" mode): whether it changed since it opened, and
    // the name it was saved with.
    in property <bool> signature-edited: false;
    in property <string> signature-saved-name: "";
    in property <[AccountRow]> accounts: [];
    in-out property <int> account-id: -1;
    in-out property <string> from-label: @tr("No connected account");
    in property <[ComposeContact]> contact-suggestions: [];
    in property <[ComposeAttachment]> attachments: [];
    in property <string> attachment-summary: "";
    // Files the message sends by link, and whether a storage service is there to send them.
    in property <[ComposeLink]> links: [];
    in property <bool> link-sharing: false;
    // The message's JPEG photos that can go out shrunk: how many, their size as they go out
    // and at full size, whether they go out shrunk, and whether they're being shrunk.
    in property <int> photo-count: 0;
    in property <string> photo-size: "";
    in property <string> photo-full-size: "";
    in-out property <bool> shrink-photos: false;
    in property <bool> shrinking-photos: false;
    // The message asks for a read receipt, which More options turns on and off.
    in-out property <bool> request-receipt: false;
    // How important the message says it is (#236): 1 high, -1 low, 0 normal.
    in-out property <int> importance: 0;
    // A forward's files are still on their way, which sending and saving wait for.
    in property <bool> attaching-files: false;
    // The message goes out as plain text only.
    in property <bool> plain-text: false;
    // What sending asks first: "subject", or "attachment" with the keyword the
    // message mentions. Answered "send", "attach" or "cancel".
    in-out property <bool> send-check-open: false;
    in property <string> send-check;
    in property <string> send-check-keyword;
    callback answer-send-check(string);
    in property <[EmailTemplateRow]> templates: [];
    in property <LocalizedMessage> message;
    in property <bool> notice-is-error: false;
    in property <int> selection-start: 0;
    in property <int> selection-end: 0;
    in property <[ComposeEditorTile]> editor-tiles: [];
    in property <float> editor-content-height: 18;
    in property <float> editor-caret-x: 0;
    in property <float> editor-caret-y: 0;
    in property <float> editor-caret-height: 18;
    // Where the selected image shows, when the selection is one image.
    in property <bool> editor-image-shown: false;
    in property <float> editor-image-x: 0;
    in property <float> editor-image-y: 0;
    in property <float> editor-image-width: 0;
    in property <float> editor-image-height: 0;
    in property <bool> bold-active: false;
    in property <bool> italic-active: false;
    in property <bool> underline-active: false;
    in property <bool> strike-active: false;
    in property <bool> code-active: false;
    in property <string> active-link-url: "";
    // What the selection's text shares, for the toolbar: its color and highlight as
    // "#rrggbb" or "none", its size and font, each empty when it mixes several, and the
    // alignment of the paragraph it starts in.
    in property <string> active-color: "none";
    in property <string> active-highlight: "none";
    in property <string> active-size: "normal";
    in property <string> active-family: "default";
    in property <string> active-align: "left";
    // The selected image's size, as "small", "medium", "large", "original" or "custom",
    // or empty when the selection isn't one image; its alt text, and its own width in pixels.
    in property <string> active-image-size: "";
    in property <string> active-image-alt: "";
    in property <int> active-image-width: 0;
    // The width it shows at, in CSS pixels.
    in property <int> active-image-shown-width: 0;
    // On the desktop a message can move into a window of its own.
    in property <bool> can-pop-out: false;
    // "reply" or "forward" while the message carries the original below the
    // editor; empty otherwise.
    in property <string> quote: "";
    // "reply" or "forward" while the user has left that original out and
    // can still put it back.
    in property <string> quote-left-out: "";
    // The original as text, for screen readers.
    in property <string> quote-text: "";
    in-out property <bool> quote-expanded: false;
    // The original, drawn read-only by the reader's renderer.
    in property <[ComposeEditorTile]> quote-tiles: [];
    in property <float> quote-height: 0;
    // Published by the editor surface for the Rust layout.
    in-out property <length> editor-width;
    in-out property <length> editor-viewport-height;
    in-out property <length> editor-scroll-y;
    in-out property <string> editor-preedit-text;
    in-out property <length> quote-top;
    out property <color> editor-text-color: AppTheme.body;
    out property <color> editor-link-color: AppTheme.accent;
    out property <color> editor-selection-color: AppTheme.accent;
    // The wavy line under misspelled words, brighter on dark backgrounds.
    out property <color> editor-misspelling-color: AppTheme.dark ? #ff7b63 : AppTheme.destructive;
    out property <color> editor-selected-text-color: white;
    // Spelling, for the editor menu: whether it can be checked here and is, the languages to
    // choose from, and the misspelled word the menu opened on with its corrections.
    in property <bool> spelling-available: false;
    in property <bool> spelling-enabled: false;
    in property <[SpellingLanguage]> spelling-languages: [];
    // The system picks the languages itself, as macOS does, so there are none to choose.
    in property <bool> spelling-languages-automatic: false;
    in property <string> spelling-word: "";
    in property <[string]> spelling-suggestions: [];
    // Bumped when the editor menu is ready to open.
    in property <int> editor-menu-serial: 0;
    // The menu is for a word tapped on a touch screen: it holds only spelling, and opens
    // below the word's line, at this height in the editor.
    in property <bool> editor-menu-touch: false;
    in property <length> editor-menu-word-bottom: 0px;

    callback close();
    callback save-signature();
    callback pop-out();
    callback save(int, string, string, string, string, string, bool);
    callback pick-attachments();
    callback ai-draft();
    // Send-later choices: the popup is open, and the chosen instant is kept
    // on the UI so the save that follows queues it. The custom choice reads
    // the date and time typed into the popup, as local time.
    in-out property <bool> schedule-open: false;
    in-out property <int> send-at: 0;
    in-out property <string> schedule-date: "";
    in-out property <string> schedule-time: "";
    callback schedule-send(int);
    callback schedule-send-custom();
    // Deliver to each To recipient as its own message. The choice only shows
    // while the To field names two or more addresses.
    in-out property <bool> deliver-individually: false;
    in property <bool> deliver-individually-visible: false;
    callback deliver-individually-toggled(bool);
    // Every change of the To field, for the choice above.
    callback recipients-changed(string);
    // Opens a picker for images to put in the text at the caret.
    callback insert-images();
    callback remove-attachment(int);
    callback remove-link(int);
    callback share-by-link();
    callback shrink-photos-toggled(bool);
    callback plain-text-chosen(bool);
    callback format(string, string, int, int);
    // Pastes the clipboard's HTML over the selection of the body given, with its
    // formatting: false when it holds none, for the plain text to go in.
    callback paste-formatted(string, int, int) -> bool;
    // Puts the selection on the clipboard with its formatting, and for a cut takes it
    // out: false when the plain text is left to copy.
    callback copy-formatted(bool, string, int, int) -> bool;
    callback link(string, string, int, int);
    callback edit-body(string, int, int, string);
    callback update-selection(string, int, int);
    callback history(string);
    callback editor-pointer-event(float, float, string, bool, bool, bool, bool);
    callback editor-key-event(string, bool, bool, bool, bool) -> bool;
    callback editor-layout-changed();
    callback search-contacts(string, int);
    callback select-contact(int, string) -> string;
    callback refresh-templates();
    callback use-template(int) -> bool;
    callback save-template(int, string, string, string, string) -> bool;
    callback delete-template(int) -> bool;
    // `text` with the last string in place of the bytes between the two offsets.
    pure callback splice-text(string, int, int, string) -> string;
    callback edit-quote();
    callback remove-quote();
    callback restore-quote();
    // The user asked for the editor menu at a point of the editor.
    callback editor-menu-requested(float, float);
    // The same, from the keyboard: for the word at the caret.
    callback editor-caret-menu-requested();
    // A tap on a touch screen, which left the caret where it landed.
    callback editor-tapped(float, float);
    callback spelling-correct(int);
    callback spelling-ignore();
    callback spelling-learn();
    callback spelling-toggle();
    callback spelling-toggle-language(int);
}

// A send-later field. LineEdit's input cannot carry an accessible id from the
// outside, so this small field puts one on its own TextInput.
component ScheduleField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> field-label;
    in property <string> field-id: "";

    height: 36px;
    border-radius: 7px;
    border-width: 1px;
    border-color: input.has-focus ? AppTheme.accent : AppTheme.input-border;
    background: AppTheme.input-bg;

    Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        visible: root.text == "";
        text: root.placeholder-text;
        color: AppTheme.placeholder;
        font-size: TypeScale.body;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        color: AppTheme.heading;
        selection-background-color: AppTheme.accent;
        selection-foreground-color: white;
        font-size: TypeScale.body;
        single-line: true;
        vertical-alignment: center;
        accessible-label: root.field-label;
        accessible-id: root.field-id;
    }
}

// The composer bound to its window's ComposerUi and the application theme.
export component BoundComposer inherits EmailComposer {
    open: ComposerUi.open;
    mode: ComposerUi.mode;
    to <=> ComposerUi.to;
    cc <=> ComposerUi.cc;
    bcc <=> ComposerUi.bcc;
    subject <=> ComposerUi.subject;
    body <=> ComposerUi.body;
    sending: ComposerUi.sending;
    drop-hint: ComposerUi.drop-hint;
    review-note: ComposerUi.review-note;
    signature-edited: ComposerUi.signature-edited;
    signature-saved-name: ComposerUi.signature-saved-name;
    accounts: ComposerUi.accounts;
    selected-account-id <=> ComposerUi.account-id;
    contact-suggestions: ComposerUi.contact-suggestions;
    attachments: ComposerUi.attachments;
    links: ComposerUi.links;
    link-sharing: ComposerUi.link-sharing;
    templates: ComposerUi.templates;
    attachment-summary: ComposerUi.attachment-summary;
    photo-count: ComposerUi.photo-count;
    photo-size: ComposerUi.photo-size;
    photo-full-size: ComposerUi.photo-full-size;
    shrink-photos <=> ComposerUi.shrink-photos;
    shrinking-photos: ComposerUi.shrinking-photos;
    request-receipt <=> ComposerUi.request-receipt;
    importance <=> ComposerUi.importance;
    attaching-files: ComposerUi.attaching-files;
    plain-text: ComposerUi.plain-text;
    send-check-open <=> ComposerUi.send-check-open;
    send-check: ComposerUi.send-check;
    send-check-keyword: ComposerUi.send-check-keyword;
    answer-send-check(answer) => { ComposerUi.answer-send-check(answer); }
    from-label <=> ComposerUi.from-label;
    notice-is-error: ComposerUi.notice-is-error;
    selection-start: ComposerUi.selection-start;
    selection-end: ComposerUi.selection-end;
    editor-tiles: ComposerUi.editor-tiles;
    editor-content-height: ComposerUi.editor-content-height;
    editor-caret-x: ComposerUi.editor-caret-x;
    editor-caret-y: ComposerUi.editor-caret-y;
    editor-caret-height: ComposerUi.editor-caret-height;
    editor-image-shown: ComposerUi.editor-image-shown;
    editor-image-x: ComposerUi.editor-image-x;
    editor-image-y: ComposerUi.editor-image-y;
    editor-image-width: ComposerUi.editor-image-width;
    editor-image-height: ComposerUi.editor-image-height;
    bold-active: ComposerUi.bold-active;
    italic-active: ComposerUi.italic-active;
    underline-active: ComposerUi.underline-active;
    strike-active: ComposerUi.strike-active;
    code-active: ComposerUi.code-active;
    active-link-url: ComposerUi.active-link-url;
    active-color: ComposerUi.active-color;
    active-highlight: ComposerUi.active-highlight;
    active-size: ComposerUi.active-size;
    active-family: ComposerUi.active-family;
    active-align: ComposerUi.active-align;
    active-image-size: ComposerUi.active-image-size;
    active-image-alt: ComposerUi.active-image-alt;
    active-image-width: ComposerUi.active-image-width;
    active-image-shown-width: ComposerUi.active-image-shown-width;
    can-pop-out: ComposerUi.can-pop-out;
    quote: ComposerUi.quote;
    quote-left-out: ComposerUi.quote-left-out;
    quote-text: ComposerUi.quote-text;
    quote-expanded <=> ComposerUi.quote-expanded;
    quote-tiles: ComposerUi.quote-tiles;
    quote-height: ComposerUi.quote-height;
    spelling-available: ComposerUi.spelling-available;
    spelling-enabled: ComposerUi.spelling-enabled;
    spelling-languages: ComposerUi.spelling-languages;
    spelling-languages-automatic: ComposerUi.spelling-languages-automatic;
    spelling-word: ComposerUi.spelling-word;
    spelling-suggestions: ComposerUi.spelling-suggestions;
    editor-menu-serial: ComposerUi.editor-menu-serial;
    editor-menu-touch: ComposerUi.editor-menu-touch;
    editor-menu-word-bottom: ComposerUi.editor-menu-word-bottom;
    background-color: AppTheme.surface;
    raised-color: AppTheme.surface-raised;
    control-color: AppTheme.control-bg;
    control-hover-color: AppTheme.muted-control-bg;
    frame-border-color: AppTheme.border;
    subtle-border-color: AppTheme.border-subtle;
    title-color: AppTheme.title;
    body-color: AppTheme.body;
    secondary-color: AppTheme.secondary;
    muted-color: AppTheme.muted;
    accent-color: AppTheme.accent;
    accent-background: AppTheme.accent-soft;

    close => { ComposerUi.close(); }
    save-signature => { ComposerUi.save-signature(); }
    pop-out => { ComposerUi.pop-out(); }
    submit(send-now) => {
        ComposerUi.save(
            ComposerUi.account-id,
            ComposerUi.to,
            ComposerUi.cc,
            ComposerUi.bcc,
            ComposerUi.subject,
            ComposerUi.body,
            send-now,
        );
    }
    pick-attachments => { ComposerUi.pick-attachments(); }
    ai-draft => { ComposerUi.ai-draft(); }
    schedule => { ComposerUi.schedule-open = true; }
    deliver-individually <=> ComposerUi.deliver-individually;
    deliver-individually-visible: ComposerUi.deliver-individually-visible;
    deliver-individually-toggled(on) => { ComposerUi.deliver-individually-toggled(on); }
    recipients-changed(recipients) => { ComposerUi.recipients-changed(recipients); }
    insert-images => { ComposerUi.insert-images(); }
    remove-attachment(index) => { ComposerUi.remove-attachment(index); }
    remove-link(index) => { ComposerUi.remove-link(index); }
    share-by-link => { ComposerUi.share-by-link(); }
    shrink-photos-toggled(on) => { ComposerUi.shrink-photos-toggled(on); }
    plain-text-chosen(plain) => { ComposerUi.plain-text-chosen(plain); }
    format-requested(kind, body, anchor, cursor) => { ComposerUi.format(kind, body, anchor, cursor); }
    paste-requested(body, anchor, cursor) => { return ComposerUi.paste-formatted(body, anchor, cursor); }
    copy-requested(cut, body, anchor, cursor) => { return ComposerUi.copy-formatted(cut, body, anchor, cursor); }
    link-requested(url, body, anchor, cursor) => { ComposerUi.link(url, body, anchor, cursor); }
    body-edited(body, anchor, cursor, key-text) => { ComposerUi.edit-body(body, anchor, cursor, key-text); }
    selection-changed(body, anchor, cursor) => { ComposerUi.update-selection(body, anchor, cursor); }
    history-requested(direction) => { ComposerUi.history(direction); }
    editor-pointer-event(x, y, kind, control, shift, alt, meta) => {
        ComposerUi.editor-pointer-event(x, y, kind, control, shift, alt, meta);
    }
    editor-key-event(key, control, shift, alt, meta) => {
        ComposerUi.editor-key-event(key, control, shift, alt, meta)
    }
    editor-layout-changed => { root.publish-layout(); }
    search-contacts(query, account-id) => { ComposerUi.search-contacts(query, account-id); }
    select-contact(index, recipients) => ComposerUi.select-contact(index, recipients);
    refresh-templates => { ComposerUi.refresh-templates(); }
    use-template(id) => ComposerUi.use-template(id);
    save-template(id, name, shortcut, subject, body) => ComposerUi.save-template(id, name, shortcut, subject, body);
    delete-template(id) => ComposerUi.delete-template(id);
    splice-text(text, start, end, insert) => ComposerUi.splice-text(text, start, end, insert);
    edit-quote => { ComposerUi.edit-quote(); }
    remove-quote => { ComposerUi.remove-quote(); }
    restore-quote => { ComposerUi.restore-quote(); }
    editor-menu-requested(x, y) => { ComposerUi.editor-menu-requested(x, y); }
    editor-caret-menu-requested => { ComposerUi.editor-caret-menu-requested(); }
    editor-tapped(x, y) => { ComposerUi.editor-tapped(x, y); }
    spelling-correct(index) => { ComposerUi.spelling-correct(index); }
    spelling-ignore => { ComposerUi.spelling-ignore(); }
    spelling-learn => { ComposerUi.spelling-learn(); }
    spelling-toggle => { ComposerUi.spelling-toggle(); }
    spelling-toggle-language(index) => { ComposerUi.spelling-toggle-language(index); }

    function publish-layout() {
        ComposerUi.editor-width = root.editor-width;
        ComposerUi.editor-viewport-height = root.editor-viewport-height;
        ComposerUi.editor-scroll-y = root.editor-scroll-y;
        ComposerUi.editor-preedit-text = root.editor-preedit-text;
        ComposerUi.quote-top = root.quote-top;
        ComposerUi.editor-layout-changed();
    }

    // A new composer's first layout is not a property change; publish it
    // once after instantiation as well as on later resizes.
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            root.publish-layout();
        }
    }

    // Send later: three short choices, or a date and time typed in as local
    // time, which Rust checks before the message is queued.
    if ComposerUi.schedule-open : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000066;
        z: 500;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(320px, parent.width - 40px);
            height: schedule-card.preferred-height;
            background: AppTheme.surface-raised;
            border-radius: 12px;
            border-width: 1px;
            border-color: AppTheme.control-border;
            schedule-card := VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text {
                    text: @tr("Send later");
                    color: AppTheme.title;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                Button {
                    text: @tr("In 1 hour");
                    accessible-id: "composer-send-later-in-1-hour";
                    clicked => { ComposerUi.schedule-send(1); }
                }
                Button {
                    text: @tr("In 4 hours");
                    accessible-id: "composer-send-later-in-4-hours";
                    clicked => { ComposerUi.schedule-send(2); }
                }
                Button {
                    text: @tr("Tomorrow");
                    accessible-id: "composer-send-later-tomorrow";
                    clicked => { ComposerUi.schedule-send(3); }
                }
                Text {
                    text: @tr("Or choose a date and time");
                    color: AppTheme.muted;
                    font-size: TypeScale.caption;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    ScheduleField {
                        text <=> ComposerUi.schedule-date;
                        placeholder-text: @tr("YYYY-MM-DD");
                        field-label: @tr("Date");
                        field-id: "composer-send-later-date";
                        horizontal-stretch: 3;
                    }
                    ScheduleField {
                        text <=> ComposerUi.schedule-time;
                        placeholder-text: @tr("HH:MM");
                        field-label: @tr("Time");
                        field-id: "composer-send-later-time";
                        horizontal-stretch: 2;
                    }
                }
                Button {
                    text: @tr("Schedule");
                    primary: true;
                    accessible-id: "composer-send-later-confirm";
                    clicked => { ComposerUi.schedule-send-custom(); }
                }
                Button {
                    text: @tr("Cancel");
                    accessible-id: "composer-send-later-cancel";
                    clicked => { ComposerUi.schedule-open = false; }
                }
            }
        }
    }
}
